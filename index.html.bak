otateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0, 20px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0, 20px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0, 20px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0)" class="text-size-small secondary-font text-style-all-caps">website &amp;<br/>design system</div><div id="w-node-_7323c15e-90ab-3efc-9250-26be235befa1-20607372" data-w-id="7323c15e-90ab-3efc-9250-26be235befa1" style="opacity:0;-webkit-transform:translate3d(0, 20px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0, 20px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0, 20px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0, 20px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0)" class="text-size-small secondary-font text-style-all-caps">ux lead<br/>ui design</div><div id="w-node-_7323c15e-90ab-3efc-9250-26be235befa7-20607372" data-w-id="7323c15e-90ab-3efc-9250-26be235befa7" style="opacity:0;-webkit-transform:translate3d(0, 20px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0, 20px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0, 20px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0, 20px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0)" class="text-size-small secondary-font text-style-all-caps"></div></div><h2 data-w-id="7323c15e-90ab-3efc-9250-26be235befaf" style="opacity:0;-webkit-transform:translate3d(0, 24%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0, 24%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0, 24%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0, 24%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0)" class="heading-large text-style-all-caps primary-font text-align-right margin-top margin-huge">champo</h2><div data-w-id="7323c15e-90ab-3efc-9250-26be235befb5" style="-webkit-transform:translate3d(0, -81%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0deg) skew(0, 0);-moz-transform:translate3d(0, -81%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0deg) skew(0, 0);-ms-transform:translate3d(0, -81%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0deg) skew(0, 0);transform:translate3d(0, -81%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0deg) skew(0, 0);width:0%" class="image-work modal third"></div></div><div class="content-section padding-horizontal padding-xxhuge"><div class="w-layout-grid grdi-2-columns modal margin-vertical margin-huge"><div id="w-node-_7323c15e-90ab-3efc-9250-26be235befb8-20607372" class="text-size-regular secondary-font text-style-all-caps">context &amp; brief/</div><p id="w-node-_7323c15e-90ab-3efc-9250-26be235befba-20607372" class="text-size-regular secondary-font">​ Chämpo (pronounced ‘shar-pour’) is the Sanskrit term for shampoo, describing the ancient Indian practice of ‘cleansing, soothing and massaging the head and hair’. Records dating back to 7th century India describe this haircare custom using handcrafted blends of plant oils and extracts – a practice deemed so effective that colonial traders in India introduced it to Britain upon their return in the early 19th century.</p></div></div><div data-w-id="7323c15e-90ab-3efc-9250-26be235befbc" class="_100wh-section third"><div class="display-flex-horizontal"><div data-w-id="7323c15e-90ab-3efc-9250-26be235befbe" class="move-image"><img src="images/63518d54522eaea2654d2152_Screenshot-2022-10-20-at-18.57.25.png" loading="lazy" sizes="(max-width: 2762px) 100vw, 2762px" srcset="images/63518d54522eaea2654d2152_Screenshot-2022-10-20-at-18.57.25-p-500.png 500w, images/63518d54522ea